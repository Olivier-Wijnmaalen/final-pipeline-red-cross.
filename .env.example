# Select "azure" or "openai".
AI_PROVIDER=azure

# Azure OpenAI configuration.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
AZURE_OPENAI_API_KEY=

# OpenAI configuration (used when AI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Optional tracing only. The pipeline always reads its approved prompts from
# the committed prompts/ directory and does not download them at runtime.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Keep false unless the project has approved sending trace data to Langfuse.
LANGFUSE_TRACING_ENABLED=false

# Optional internal web application settings.
# DEMA_BASELINE_BANK=C:\approved\base_evidence_bank.json
# PYTHON_BIN=C:\path\to\python.exe
# DEMA_RUNS_DIR=C:\private\dema-runs
# Production/Vercel live mode requires an approved remote worker.
DEMA_REMOTE_WORKER_URL=
DEMA_REMOTE_WORKER_TOKEN=
